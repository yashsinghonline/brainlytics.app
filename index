    <div class="container">
      <a href="/" class="logo" aria-label="Brain Games home">
        <img src="assets/icon-192.png" alt="" width="28" height="28" class="logo-img" />
        <span class="logo-text">Brain Games</span>
      </a>
      <nav class="nav-primary" aria-label="Primary">
        <a href="/" class="nav-link active">Home</a>
